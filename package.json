{
  "name": "@bloom-group/serenity-process",
  "version": "0.2.1",
  "description": "Process: like a Serenity/JS Task, but performed by several actors, each playing a role",
  "keywords": [
    "serenity-js",
    "serenity",
    "testing",
    "bdd",
    "screenplay",
    "multi-actor",
    "process",
    "eslint",
    "eslintplugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BloomTechNL/serenity-process.git"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./eslint": {
      "types": "./lib/eslint/index.d.ts",
      "default": "./lib/eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@serenity-js/core": "^3.0.0",
    "eslint": ">=9"
  },
  "devDependencies": {
    "@serenity-js/core": "^3.49.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
